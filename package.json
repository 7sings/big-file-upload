{
  "name": "big-file-upload",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && env WRANGLER_LOG_PATH=/private/tmp/big-upload-wrangler-dev.log wrangler dev",
    "build": "npm run build -w @big-upload/shared && npm run build -w @big-upload/upload-core && npm run build -w @big-upload/web && npm run build -w @big-upload/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "npm run migrate -w @big-upload/api",
    "cleanup": "npm run cleanup -w @big-upload/api",
    "cf:types": "env WRANGLER_LOG_PATH=/private/tmp/big-upload-wrangler-types.log wrangler types apps/api/src/worker-configuration.d.ts",
    "cf:dry-run": "npm run build && env WRANGLER_LOG_PATH=/private/tmp/big-upload-wrangler-dry-run.log wrangler deploy --dry-run",
    "cf:startup": "env WRANGLER_LOG_PATH=/private/tmp/big-upload-wrangler-startup.log wrangler check startup"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}
