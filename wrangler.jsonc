{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "big-upload",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "KV_DO", "class_name": "KvDurableObject" }],
  },
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "big-file-upload" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KvDurableObject"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    "R2_REGION": "auto",
    "RESEND_API_URL": "https://api.resend.com",
    "RESEND_TIMEOUT_MS": "10000",
    "MAX_FILE_SIZE_BYTES": "5368709120",
    "MAX_ACTIVE_UPLOADS_PER_USER": "5",
    "UPLOAD_STALE_AFTER_SECONDS": "86400",
    "PART_URL_TTL_SECONDS": "900",
    "PREVIEW_URL_TTL_SECONDS": "300",
    "OTP_TTL_SECONDS": "600",
    "SESSION_TTL_SECONDS": "604800",
    "LOG_LEVEL": "info",
  },
  "secrets": {
    "required": [
      "COOKIE_SECRET",
      "OTP_PEPPER",
      "DATABASE_URL",
      "DATABASE_AUTH_TOKEN",
      "RESEND_API_KEY",
      "MAIL_FROM",
      "R2_ENDPOINT",
      "R2_BUCKET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
    ],
  },
}
